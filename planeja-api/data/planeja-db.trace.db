SELECT
    to_char(data, 'YYYY-MM') AS mes,
    COUNT(*) AS quantidade,
    SUM(CASE WHEN tipo = 'RECEITA' THEN valor ELSE 0 END) AS total_receitas,
    SUM(CASE WHEN tipo = 'DESPESA' THEN valor ELSE 0 END) AS total_despesas
FROM lancamentos
