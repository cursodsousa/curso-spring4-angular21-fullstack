org.h2.jdbc.JdbcSQLDataException: Cannot parse "INTERVAL" constant "1 month"; SQL statement:
WITH meses AS (
    SELECT data_mes::date AS mes
    FROM generate_series(
        DATE '2026-01-01',
        DATE '2026-12-01',
        INTERVAL '1 month'
    ) AS data_mes
),
dias AS (
    SELECT *
    FROM unnest(
        ARRAY[2, 5, 8, 11, 14, 17, 20, 23, 26, 28]
    ) WITH ORDINALITY AS d(dia, ordem)
),
cartoes AS (
    SELECT ARRAY[
        '79e0176d-b236-4e2b-ba6f-a357b97fcac0'::uuid, -- Nubank Platinum
        'e31bf084-359c-4d7a-9dfb-0a19296b0ce8'::uuid, -- Rabobank
        '571389e7-eb42-430d-bd55-99147787f914'::uuid, -- Itaú Personnalité
        '9efe71e2-417c-4b9a-a0e5-ad58ac36ae4f'::uuid, -- Cartão Nubank
        '0e9c6ee6-42a5-4ba8-9bc2-d97206eeebbc'::uuid, -- Bradescard
        '59103919-b7a1-4466-a356-d400c344387c'::uuid, -- Banco XPTO
        'd03fadb7-4c6d-42a6-a9db-2d4a1c863aec'::uuid  -- BB Card
    ] AS ids
),
base AS (
    SELECT
        m.mes,
        d.dia,
        d.ordem,
        EXTRACT(MONTH FROM m.mes)::integer AS numero_mes,
        CASE
            WHEN d.ordem IN (1, 2) THEN 'RECEITA'
            ELSE 'DESPESA'
        END AS tipo
    FROM meses m
    CROSS JOIN dias d
)
INSERT INTO lancamentos (
    id,
    data,
    tipo,
    valor,
    cartao_id,
    categoria_id,
    descricao
)
SELECT
    gen_random_uuid(),

    make_date(
        2026,
        b.numero_mes,
        b.dia
    ) AS data,

    b.tipo,

    CASE b.ordem
        -- Receitas
        WHEN 1 THEN 6000.00 + (b.numero_mes * 25.00)
        WHEN 2 THEN 300.00  + (b.numero_mes * 35.00)

        -- Despesas
        WHEN 3 THEN 180.90 + (b.numero_mes * 7.00)
        WHEN 4 THEN 110.00 + (b.numero_mes * 4.00)
        WHEN 5 THEN 85.50  + (b.numero_mes * 6.00)
        WHEN 6 THEN 65.90  + (b.numero_mes * 3.00)
        WHEN 7 THEN 42.00  + (b.numero_mes * 2.00)
        WHEN 8 THEN 150.00 + (b.numero_mes * 8.00)
        WHEN 9 THEN 320.00 + (b.numero_mes * 5.00)
        WHEN 10 THEN 210.00 + (b.numero_mes * 4.00)
    END::numeric(15, 2) AS valor,

    CASE
        -- Receitas nunca possuem cartão.
        -- Os lançamentos 7 e 8 simulam despesas pagas sem cartão.
        WHEN b.tipo = 'DESPESA'
             AND b.ordem NOT IN (7, 8)
        THEN c.ids[
            (
                (
                    b.numero_mes
                    + b.ordem::integer
                    - 2
                ) % 7
            ) + 1
        ]
        ELSE NULL::uuid
    END AS cartao_id,

    CASE b.ordem
        WHEN 1 THEN 'cc9e3e41-0067-4401-b94e-35187f0671d2'::uuid -- Salário
        WHEN 2 THEN '3078af8b-11d4-44c5-990b-06a19bc3c7e8'::uuid -- Renda Extra

        WHEN 3 THEN '9bb81874-5725-4a79-9c8b-82902c668965'::uuid -- Alimentação
        WHEN 4 THEN 'dce30174-4d6d-4b00-9486-eb3e7190e5bb'::uuid -- Transporte
        WHEN 5 THEN 'acf29d5a-579f-483b-9743-02d0d2604eb8'::uuid -- Saúde
        WHEN 6 THEN '9bb81874-5725-4a79-9c8b-82902c668965'::uuid -- Alimentação
        WHEN 7 THEN 'dce30174-4d6d-4b00-9486-eb3e7190e5bb'::uuid -- Transporte
        WHEN 8 THEN 'acf29d5a-579f-483b-9743-02d0d2604eb8'::uuid -- Saúde
        WHEN 9 THEN '9bb81874-5725-4a79-9c8b-82902c668965'::uuid -- Alimentação
        WHEN 10 THEN 'acf29d5a-579f-483b-9743-02d0d2604eb8'::uuid -- Saúde
    END AS categoria_id,

    CASE b.ordem
        WHEN 1 THEN 'Salário mensal - ' || to_char(b.mes, 'MM/YYYY')
        WHEN 2 THEN 'Serviço freelance - ' || to_char(b.mes, 'MM/YYYY')
        WHEN 3 THEN 'Compra no supermercado'
        WHEN 4 THEN 'Abastecimento do veículo'
        WHEN 5 THEN 'Compra na farmácia'
        WHEN 6 THEN 'Almoço em restaurante'
        WHEN 7 THEN 'Transporte por aplicativo'
        WHEN 8 THEN 'Consulta ou exame médico'
        WHEN 9 THEN 'Compras de alimentação do mês'
        WHEN 10 THEN 'Plano de saúde'
    END AS descricao

FROM base b
CROSS JOIN cartoes c
ORDER BY b.mes, b.ordem [22007-240]
